<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="HomeSmokeButton" parent="android:style/Widget.Material.Button">
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="HomeSmokeCheckBox" parent="android:style/Widget.Material.CompoundButton.CheckBox">
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">#2563EB</item>
        <item name="android:windowBackground">#F5F7FA</item>
        <item name="android:navigationBarColor">#F5F7FA</item>
        <item name="android:statusBarColor">#0F2744</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:buttonStyle">@style/HomeSmokeButton</item>
        <item name="android:checkboxStyle">@style/HomeSmokeCheckBox</item>
    </style>
</resources>
